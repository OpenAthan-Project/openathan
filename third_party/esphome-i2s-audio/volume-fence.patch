+VolumeFenceToken I2SAudioSpeakerBase::request_volume_with_fence(float level) {
+  if (!volume_fence_enabled_ || !std::isfinite(level) || level < 0 || level > 1) return {};
+  const int32_t factor = level >= 1 ? INT32_MAX : level <= 0 ? 0 :
+      esp_audio_libs::gain::db_to_q31(remap<float, float>(level, 0, 1, SOFTWARE_VOLUME_MIN_DB, 0));
+  portENTER_CRITICAL(&volume_mutex_);
+  auto token = volume_fence_.request(level, factor);
+  portEXIT_CRITICAL(&volume_mutex_);
+  return token;
+}
+
+bool I2SAudioSpeakerBase::volume_fence_healthy() {
+  constexpr uint32_t faults = ERR_ESP_NO_MEM | ERR_DROPPED_EVENT | ERR_PARTIAL_WRITE | ERR_LOCKSTEP_DESYNC;
+  if (is_failed() || (event_group_ && (xEventGroupGetBits(event_group_) & faults))) fail_volume_fence_();
+  portENTER_CRITICAL(&volume_mutex_);
+  bool healthy = volume_fence_enabled_ && !volume_fence_.failed();
+  portEXIT_CRITICAL(&volume_mutex_);
+  return healthy;
+}
+
+VolumeFenceStatus I2SAudioSpeakerBase::volume_fence_status(VolumeFenceToken token) {
+  if (!volume_fence_healthy()) return VolumeFenceStatus::FAILED;
+  if (event_group_ && (xEventGroupGetBits(event_group_) & (COMMAND_STOP | COMMAND_STOP_GRACEFULLY |
+                                                         TASK_STOPPING | TASK_STOPPED)))
+    return VolumeFenceStatus::CANCELLED;
+  portENTER_CRITICAL(&volume_mutex_);
+  auto status = volume_fence_.status(token);
+  portEXIT_CRITICAL(&volume_mutex_);
+  return status;
+}
+
+VolumeGain I2SAudioSpeakerBase::volume_gain_snapshot_() {
+  portENTER_CRITICAL(&volume_mutex_);
+  auto gain = volume_fence_.snapshot();
+  portEXIT_CRITICAL(&volume_mutex_);
+  return gain;
+}
+float I2SAudioSpeakerBase::fenced_volume() {
+  portENTER_CRITICAL(&volume_mutex_);
+  float level = volume_fence_.level();
+  portEXIT_CRITICAL(&volume_mutex_);
+  return level;
+}
+void I2SAudioSpeakerBase::complete_volume_fence_(VolumeFenceToken token) {
+  portENTER_CRITICAL(&volume_mutex_);
+  // Records from other sessions are never admissible, even if their gain agrees.
+  if (token.session != volume_fence_.snapshot().token.session) volume_fence_.fail();
+  else volume_fence_.complete(token);
+  portEXIT_CRITICAL(&volume_mutex_);
+}
+void I2SAudioSpeakerBase::fail_volume_fence_() {
+  if (!volume_fence_enabled_) return;
+  portENTER_CRITICAL(&volume_mutex_);
+  volume_fence_.fail();
+  portEXIT_CRITICAL(&volume_mutex_);
+}
+void I2SAudioSpeakerBase::begin_volume_session_() {
+  if (!volume_fence_enabled_) return;
+  portENTER_CRITICAL(&volume_mutex_);
+  if (!volume_fence_.active()) volume_fence_.begin_session();
+  portEXIT_CRITICAL(&volume_mutex_);
+}
+void I2SAudioSpeakerBase::end_volume_session_() {
+  if (!volume_fence_enabled_) return;
+  portENTER_CRITICAL(&volume_mutex_);
+  volume_fence_.end_session();
+  portEXIT_CRITICAL(&volume_mutex_);
+}
+#endif
